<%- include('./partials/header') %>

    <div class="w-full min-h-screen flex px-20 py-20 gap-10">

        <% if(!user.cart || user.cart.length===0){ %>

            <!-- EMPTY CART -->
            <div class="w-full flex flex-col items-center justify-center gap-6">

                <h1 class="text-4xl font-semibold text-gray-600">
                    Your Cart is Empty
                </h1>

                <a href="/shop" class="px-6 py-3 bg-black text-white rounded-md hover:bg-gray-800">
                    Continue Shopping
                </a>

            </div>

            <% } else { %>

                <!-- LEFT SIDE : CART PRODUCTS -->

                <div class="w-[60%] flex flex-col gap-8">

                    <% user.cart.forEach(function(product){ %>

                        <div class="relative rounded-md overflow-hidden shadow w-[420px]">

                            <!-- REMOVE PRODUCT -->
                            <a href="/removefromcart/<%= product._id %>"
                                class="absolute top-2 right-2 w-7 h-7 bg-red-500 text-white flex items-center justify-center rounded-full hover:bg-red-600">
                                <i class="ri-close-line"></i>
                            </a>

                            <!-- PRODUCT IMAGE -->
                            <div class="w-full flex justify-center items-center h-52 bg-[<%= product.bgcolor %>]">
                                <img class="h-36 object-contain"
                                    src="data:image/jpeg;base64,<%= product.image.toString('base64') %>">
                            </div>

                            <!-- PRODUCT NAME + QTY -->
                            <div class="w-full flex justify-between px-5 py-3 bg-[<%= product.panelcolor %>]">

                                <h3 class="text-lg font-semibold">
                                    <%= product.name %>
                                </h3>

                                <div class="flex items-center gap-2">

                                    <i
                                        class="w-6 h-6 bg-white flex rounded-full items-center justify-center ri-add-line"></i>

                                    <div class="px-2 py-1 rounded-md bg-white text-black text-sm">
                                        1
                                    </div>

                                    <i
                                        class="w-6 h-6 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>

                                </div>

                            </div>

                            <!-- PRODUCT PRICE -->
                            <div class=" text-white flex items-center justify-between px-5 py-2 bg-[<%= product.textcolor %>]">
                                <h4 class="text-sm">Net Total</h4>
                                <h2 class="text-sm font-semibold">₹ <%= product.price %>
                                </h2>
                            </div>

                        </div>

                        <% }) %>

                </div>


                <!-- RIGHT SIDE : PRICE BREAKDOWN -->

                <div class="w-[40%] sticky top-24 h-fit border rounded-md p-6 bg-white">

                    <h2 class="text-2xl font-semibold mb-6">Price Breakdown</h2>

                    <% let total=0; user.cart.forEach(function(product){ total +=product.price; }) %>

                        <div class="flex justify-between mb-3">
                            <span>Total MRP</span>
                            <span>₹ <%= total %></span>
                        </div>

                        <div class="flex justify-between mb-3">
                            <span>Discount</span>
                            <span>₹ 0</span>
                        </div>

                        <div class="flex justify-between mb-3">
                            <span>Platform Fee</span>
                            <span>₹ 20</span>
                        </div>

                        <div class="flex justify-between mb-3">
                            <span>Shipping</span>
                            <span>FREE</span>
                        </div>

                        <div class="w-full h-[1px] bg-gray-300 my-5"></div>

                        <div class="flex justify-between text-lg font-semibold text-green-600">
                            <span>Total Amount</span>
                            <span>₹ <%= total + 20 %></span>
                        </div>

                        <button class="w-full mt-6 bg-black text-white py-3 rounded-md hover:bg-gray-800">
                            Checkout
                        </button>

                </div>

                <% } %>

    </div>

    <%- include('./partials/footer') %>